diff --git a/.github/workflows/release.yml b/.github/workflows/release.yml
new file mode 100644
index 0000000..6333724
--- /dev/null
+++ b/.github/workflows/release.yml
@@ -0,0 +1,147 @@
+name: Release PROD
+
+on:
+  push:
+    tags:
+      - "v*.*.*"
+
+permissions:
+  contents: read
+
+concurrency:
+  group: production-release
+  cancel-in-progress: false
+
+env:
+  AWS_REGION: ${{ vars.AWS_REGION }}
+  ECR_REGISTRY: ${{ vars.PROD_AWS_ACCOUNT_ID }}.dkr.ecr.${{ vars.AWS_REGION }}.amazonaws.com
+
+jobs:
+  verify:
+    runs-on: ubuntu-latest
+    steps:
+      - uses: actions/checkout@v7
+        with:
+          fetch-depth: 0
+
+      - name: Verify release tag belongs to main
+        shell: bash
+        run: |
+          [[ "$GITHUB_REF_NAME" =~ ^v[0-9]+\.[0-9]+\.[0-9]+$ ]] || exit 1
+          git fetch origin main
+          git merge-base --is-ancestor "$GITHUB_SHA" origin/main
+
+      - uses: actions/setup-java@v6
+        with:
+          distribution: temurin
+          java-version: "21"
+          cache: maven
+
+      - name: Run tests
+        run: chmod +x mvnw && ./mvnw -B clean verify
+
+  release:
+    needs: verify
+    runs-on: ubuntu-latest
+    timeout-minutes: 60
+    environment: production
+    permissions:
+      contents: read
+      id-token: write
+    steps:
+      - uses: actions/checkout@v7
+      - uses: aws-actions/configure-aws-credentials@v6
+        with:
+          role-to-assume: ${{ vars.PROD_DEPLOY_ROLE_ARN }}
+          aws-region: ${{ vars.AWS_REGION }}
+          allowed-account-ids: ${{ vars.PROD_AWS_ACCOUNT_ID }}
+      - uses: aws-actions/amazon-ecr-login@v2
+
+      - name: Build and push immutable release images
+        shell: bash
+        run: |
+          for service in transport-service audit-consumer; do
+            REPOSITORY="cdc-kafka-$service"
+            IMAGE="$ECR_REGISTRY/$REPOSITORY:$GITHUB_REF_NAME"
+            if aws ecr describe-images --repository-name "$REPOSITORY" \
+              --image-ids "imageTag=$GITHUB_REF_NAME" >/dev/null 2>&1; then
+              echo "Using existing image: $IMAGE"
+            else
+              docker build -t "$IMAGE" "./$service"
+              docker push "$IMAGE"
+            fi
+          done
+
+      - name: Find one running PROD EC2
+        id: instance
+        shell: bash
+        run: |
+          INSTANCES="$(aws ec2 describe-instances \
+            --filters 'Name=tag:Name,Values=cdc-kafka-prod' 'Name=instance-state-name,Values=running' \
+            --query 'Reservations[].Instances[].InstanceId' --output text)"
+          read -ra IDS <<< "$INSTANCES"
+          if [[ ${#IDS[@]} -ne 1 ]]; then
+            echo "Expected one running production host, found ${#IDS[@]}" >&2
+            exit 1
+          fi
+          echo "instance_id=${IDS[0]}" >> "$GITHUB_OUTPUT"
+
+      - name: Wait for Systems Manager agent
+        env:
+          INSTANCE_ID: ${{ steps.instance.outputs.instance_id }}
+        shell: bash
+        run: |
+          for attempt in {1..60}; do
+            STATUS="$(aws ssm describe-instance-information \
+              --filters "Key=InstanceIds,Values=$INSTANCE_ID" \
+              --query 'InstanceInformationList[0].PingStatus' --output text)"
+            [[ "$STATUS" == Online ]] && exit 0
+            sleep 10
+          done
+          echo 'SSM agent not online' >&2
+          exit 1
+
+      - name: Deploy applications and run local smoke checks through SSM
+        env:
+          INSTANCE_ID: ${{ steps.instance.outputs.instance_id }}
+        shell: bash
+        run: |
+          # Only the compose file and deployment script are sent: the EC2 instance
+          # reads database credentials locally from Secrets Manager.
+          ARCHIVE="$(tar -czf - compose.prod.yml scripts/deploy-prod.sh | base64 -w0)"
+          REMOTE_COMMAND=$(cat <<EOF_REMOTE
+          set -eu
+          cloud-init status --wait >/dev/null
+          mkdir -p /opt/cdc-kafka/scripts
+          printf '%s' '$ARCHIVE' | base64 -d | tar -xz -C /opt/cdc-kafka
+          chmod 700 /opt/cdc-kafka/scripts/deploy-prod.sh
+          bash /opt/cdc-kafka/scripts/deploy-prod.sh '$AWS_REGION' '$ECR_REGISTRY' '$GITHUB_REF_NAME'
+          EOF_REMOTE
+          )
+          PARAMETERS="$(jq -nc --arg command "$REMOTE_COMMAND" '{commands:[$command],executionTimeout:["1800"]}')"
+          COMMAND_ID="$(aws ssm send-command --instance-ids "$INSTANCE_ID" \
+            --document-name AWS-RunShellScript \
+            --comment "Deploy $GITHUB_REF_NAME" \
+            --parameters "$PARAMETERS" --query Command.CommandId --output text)"
+          echo "SSM command: $COMMAND_ID"
+          for attempt in {1..210}; do
+            STATUS="$(aws ssm get-command-invocation \
+              --command-id "$COMMAND_ID" --instance-id "$INSTANCE_ID" \
+              --query Status --output text 2>/dev/null || true)"
+            case "$STATUS" in
+              Success)
+                aws ssm get-command-invocation --command-id "$COMMAND_ID" \
+                  --instance-id "$INSTANCE_ID" --query StandardOutputContent --output text
+                exit 0
+                ;;
+              Failed|Cancelled|Cancelling|TimedOut)
+                aws ssm get-command-invocation --command-id "$COMMAND_ID" \
+                  --instance-id "$INSTANCE_ID" \
+                  --query '{Status:Status,Output:StandardOutputContent,Error:StandardErrorContent}'
+                exit 1
+                ;;
+            esac
+            sleep 10
+          done
+          echo "SSM command still running: $COMMAND_ID (last status: $STATUS)" >&2
+          exit 1
diff --git a/compose.prod.yml b/compose.prod.yml
new file mode 100644
index 0000000..2d05e61
--- /dev/null
+++ b/compose.prod.yml
@@ -0,0 +1,49 @@
+# PROD runs application containers only. RDS and MSK are managed AWS services.
+# All ports are loopback-only; no public application ingress until HTTPS/auth is ready.
+x-common: &common
+  restart: unless-stopped
+  stop_grace_period: 30s
+  logging:
+    driver: local
+    options:
+      max-size: "10m"
+      max-file: "3"
+
+services:
+  transport-service:
+    <<: *common
+    image: ${TRANSPORT_IMAGE:?TRANSPORT_IMAGE is required}
+    ports:
+      - "127.0.0.1:8080:8080"
+    environment:
+      DB_HOST: ${RDS_HOST:?RDS_HOST is required}
+      DB_PORT: "5432"
+      DB_NAME: transport
+      DB_USERNAME: ${TRANSPORT_DB_USERNAME:?TRANSPORT_DB_USERNAME is required}
+      DB_PASSWORD: ${TRANSPORT_DB_PASSWORD:?TRANSPORT_DB_PASSWORD is required}
+      SPRING_DATASOURCE_URL: jdbc:postgresql://${RDS_HOST}:5432/transport?sslmode=require
+      SPRING_FLYWAY_URL: jdbc:postgresql://${RDS_HOST}:5432/transport?sslmode=require
+      TRANSPORT_DB_MAX_POOL_SIZE: "5"
+      TRANSPORT_DB_MIN_IDLE: "1"
+
+  audit-consumer:
+    <<: *common
+    image: ${AUDIT_IMAGE:?AUDIT_IMAGE is required}
+    ports:
+      - "127.0.0.1:8081:8081"
+    environment:
+      SPRING_PROFILES_ACTIVE: prod
+      SERVER_PORT: "8081"
+      AUDIT_DB_HOST: ${RDS_HOST}
+      AUDIT_DB_PORT: "5432"
+      AUDIT_DB_NAME: audit
+      AUDIT_DB_USERNAME: ${AUDIT_DB_USERNAME:?AUDIT_DB_USERNAME is required}
+      AUDIT_DB_PASSWORD: ${AUDIT_DB_PASSWORD:?AUDIT_DB_PASSWORD is required}
+      SPRING_DATASOURCE_URL: jdbc:postgresql://${RDS_HOST}:5432/audit?sslmode=require
+      KAFKA_BOOTSTRAP_SERVERS: ${MSK_BROKERS:?MSK_BROKERS is required}
+      AUDIT_KAFKA_CONSUMER_ENABLED: "true"
+      AUDIT_DLT_REPLAY_ENABLED: "false"
+      AUDIT_DLT_REPLICATION_FACTOR: "3"
+      AUDIT_KAFKA_CONCURRENCY: "2"
+      AUDIT_DB_MAX_POOL_SIZE: "5"
+      AUDIT_DB_MIN_IDLE: "1"
