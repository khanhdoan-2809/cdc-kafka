new file mode 100644
index 0000000..d2ea956
--- /dev/null
+++ b/.github/workflows/bootstrap-prod-db.yml
@@ -0,0 +1,98 @@
+name: Bootstrap PROD Databases
+
+on:
+  workflow_dispatch:
+
+permissions:
+  contents: read
+
+concurrency:
+  group: production-db-bootstrap
+  cancel-in-progress: false
+
+jobs:
+  bootstrap:
+    runs-on: ubuntu-latest
+    environment: production
+    env:
+      AWS_REGION: ${{ vars.AWS_REGION }}
+    permissions:
+      contents: read
+      id-token: write
+    steps:
+      - uses: actions/checkout@v7
+      - uses: aws-actions/configure-aws-credentials@v6
+        with:
+          role-to-assume: ${{ vars.PROD_DEPLOY_ROLE_ARN }}
+          aws-region: ${{ vars.AWS_REGION }}
+          allowed-account-ids: ${{ vars.PROD_AWS_ACCOUNT_ID }}
+
+      - name: Initialize application DB secrets once
+        shell: bash
+        run: |
+          set -euo pipefail
+          umask 077
+          ensure_secret() {
+            local name="$1" username="$2" database="$3"
+            local secret_id="cdc-kafka/prod/database/$name"
+            if aws secretsmanager get-secret-value --secret-id "$secret_id" >/dev/null 2>&1; then
+              echo "Already initialized: $name"
+              return
+            fi
+            # Do not treat missing permissions or a missing Terraform secret as success.
+            aws secretsmanager describe-secret --secret-id "$secret_id" >/dev/null
+            local password file
+            password="$(aws secretsmanager get-random-password --password-length 32 \
+              --exclude-punctuation --query RandomPassword --output text)"
+            file="$(mktemp)"
+            jq -n --arg u "$username" --arg p "$password" --arg d "$database" \
+              '{username:$u,password:$p,dbname:$d}' > "$file"
+            aws secretsmanager put-secret-value --secret-id "$secret_id" \
+              --secret-string "file://$file" >/dev/null
+            rm -f "$file"
+            unset password
+            echo "Initialized: $name"
+          }
+          ensure_secret transport-app transport_app transport
+          ensure_secret audit-app audit_app audit
+          ensure_secret debezium debezium transport
+
+      - name: Bootstrap RDS from production EC2 over SSM
+        shell: bash
+        run: |
+          set -euo pipefail
+          INSTANCES="$(aws ec2 describe-instances \
+            --filters 'Name=tag:Name,Values=cdc-kafka-prod' 'Name=instance-state-name,Values=running' \
+            --query 'Reservations[].Instances[].InstanceId' --output text)"
+          read -ra IDS <<< "$INSTANCES"
+          [[ ${#IDS[@]} -eq 1 ]] || { echo 'Expected exactly one production EC2' >&2; exit 1; }
+          INSTANCE_ID="${IDS[0]}"
+
+          # Only the script is transported; all secret values are read by EC2.
+          PAYLOAD="$(gzip -c scripts/bootstrap-prod-db.sh | base64 -w0)"
+          REMOTE_COMMAND="set -eu; mkdir -p /opt/cdc-kafka/scripts; printf '%s' '$PAYLOAD' | base64 -d | gunzip > /opt/cdc-kafka/scripts/bootstrap-prod-db.sh; chmod 700 /opt/cdc-kafka/scripts/bootstrap-prod-db.sh; bash /opt/cdc-kafka/scripts/bootstrap-prod-db.sh '$AWS_REGION'"
+          PARAMETERS="$(jq -nc --arg c "$REMOTE_COMMAND" '{commands:[$c],executionTimeout:["1200"]}')"
+          COMMAND_ID="$(aws ssm send-command --instance-ids "$INSTANCE_ID" \
+            --document-name AWS-RunShellScript --parameters "$PARAMETERS" \
+            --comment 'Initialize production RDS databases' \
+            --query Command.CommandId --output text)"
+
+          for attempt in {1..150}; do
+            STATUS="$(aws ssm get-command-invocation --command-id "$COMMAND_ID" \
+              --instance-id "$INSTANCE_ID" --query Status --output text 2>/dev/null || true)"
+            case "$STATUS" in
+              Success)
+                echo 'RDS bootstrap completed successfully'
+                exit 0
+                ;;
+              Failed|Cancelled|Cancelling|TimedOut)
+                aws ssm get-command-invocation --command-id "$COMMAND_ID" \
+                  --instance-id "$INSTANCE_ID" \
+                  --query '{Status:Status,Output:StandardOutputContent,Error:StandardErrorContent}'
+                exit 1
+                ;;
+            esac
+            sleep 8
+          done
+          echo "RDS bootstrap timed out; inspect SSM command $COMMAND_ID" >&2
+          exit 1
